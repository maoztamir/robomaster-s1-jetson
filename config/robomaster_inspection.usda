#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "RoboMaster" (
        prepend references = @/home/ubuntu/robomaster-s1-jetson/assets/robomaster/robomaster.usd@</robomaster_s1_base>
    ) {}

    def DomeLight "Light"
    {
        float inputs:intensity = 1000
    }

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.18, 0.18, 0.18)]
        double3 xformOp:translate = (0, 0, -0.05)
        double3 xformOp:scale = (4, 4, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
