Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 35; 35; 40
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Room map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Simulated LiDAR
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
      Size (Pixels): 3
      Style: Points
    - Class: rviz_default_plugins/Marker
      Name: RoboMaster footprint
      Enabled: true
      Topic:
        Value: /simulation/robot_marker
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: Planned route
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Map
      Name: Local obstacles
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Enabled: true
      Topic:
        Value: /stereo/left/camera/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Right camera
      Enabled: true
      Topic:
        Value: /stereo/right/camera/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: map
      Scale: 90
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 1400
  Height: 900
