<launch>
  <arg name="config_dir"/>
  <arg name="database_path"/>
  <node pkg="rtabmap_sync" exec="stereo_sync" name="stereo_sync" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="approx_sync" value="false"/>
    <param name="qos" value="2"/>
    <param name="qos_camera_info" value="2"/>
    <remap from="left/image_rect" to="/stereo/left/camera/image_raw"/>
    <remap from="right/image_rect" to="/stereo/right/camera/image_raw"/>
    <remap from="left/camera_info" to="/stereo/left/camera/camera_info"/>
    <remap from="right/camera_info" to="/stereo/right/camera/camera_info"/>
    <remap from="rgbd_image" to="/stereo/paired"/>
  </node>
  <node pkg="rtabmap_slam" exec="rtabmap" name="rtabmap" output="screen">
    <param from="$(var config_dir)/robomaster_slam.yaml"/>
    <param name="database_path" value="$(var database_path)"/>
    <!-- Ideal pinhole renderings have zero distortion and are already rectified. -->
    <remap from="left/image_rect" to="/stereo/left/camera/image_raw"/>
    <remap from="right/image_rect" to="/stereo/right/camera/image_raw"/>
    <remap from="left/camera_info" to="/stereo/left/camera/camera_info"/>
    <remap from="right/camera_info" to="/stereo/right/camera/camera_info"/>
    <remap from="scan" to="/scan"/>
    <remap from="rgbd_image" to="/stereo/paired"/>
    <remap from="grid_map" to="/map"/>
  </node>
</launch>
