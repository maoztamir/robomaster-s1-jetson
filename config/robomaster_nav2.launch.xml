<launch>
  <arg name="config_dir" default="/home/ubuntu/robomaster-s1-jetson/config"/>
  <node pkg="nav2_controller" exec="controller_server" name="controller_server" output="screen">
    <param from="$(var config_dir)/robomaster_nav2.yaml"/>
    <remap from="cmd_vel" to="cmd_vel_nav"/>
  </node>
  <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen"><param from="$(var config_dir)/robomaster_nav2.yaml"/></node>
  <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server" output="screen"><param from="$(var config_dir)/robomaster_nav2.yaml"/></node>
  <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server" output="screen">
    <param from="$(var config_dir)/robomaster_nav2.yaml"/>
    <remap from="cmd_vel" to="cmd_vel_nav"/>
  </node>
  <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator" output="screen">
    <param from="$(var config_dir)/robomaster_nav2.yaml"/>
    <param name="default_nav_to_pose_bt_xml" value="$(var config_dir)/robomaster_navigate.xml"/>
  </node>
  <node pkg="nav2_velocity_smoother" exec="velocity_smoother" name="velocity_smoother" output="screen">
    <param from="$(var config_dir)/robomaster_nav2.yaml"/>
    <remap from="cmd_vel" to="cmd_vel_nav"/>
    <remap from="cmd_vel_smoothed" to="cmd_vel"/>
  </node>
  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_navigation" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="autostart" value="true"/>
    <param name="node_names" value="['controller_server','planner_server','smoother_server','behavior_server','velocity_smoother','bt_navigator']"/>
  </node>
</launch>
