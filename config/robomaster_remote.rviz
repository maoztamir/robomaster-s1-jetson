# ROS 2 Humble. Sensor topics/frames from isaac_robot_measurements.yaml.
# Sensor publishers must run on the Jetson; this file only configures viewing.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 30; 30; 34
    Fixed Frame: laser
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (metres, lidar frame)
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 24
      Color: 100; 100; 110
      Alpha: 0.4
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/LaserScan
      Name: RPLIDAR A1
      Enabled: true
      Value: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 220; 255
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Enabled: true
      Value: true
      Topic:
        Value: /stereo/left/camera/image_raw/compressed
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Right camera
      Enabled: true
      Value: true
      Topic:
        Value: /stereo/right/camera/image_raw/compressed
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Normalize Range: true
    - Class: rviz_default_plugins/TF
      Name: TF (enable when transforms are published)
      Enabled: false
      Value: false
      Show Axes: true
      Show Arrows: true
      Show Names: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 50
      Angle: 0
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
