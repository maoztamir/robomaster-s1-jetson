[Unit]
Description=RoboMaster PS4 gamepad input
Wants=bluetooth.service network-online.target
After=bluetooth.service network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/robomaster-s1-jetson
Environment=ROS_DOMAIN_ID=42
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/home/ubuntu/robomaster-s1-jetson/config/calibration_dds.local.xml
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && exec ros2 run joy_linux joy_linux_node --ros-args -r __node:=joy_node --params-file /home/ubuntu/robomaster-s1-jetson/config/ps4_teleop.yaml -r joy:=/robomaster/joy"
KillSignal=SIGINT
TimeoutStopSec=10
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
